# Copy to .env.local (local) and add the same keys in Vercel > Settings > Environment Variables.
# Never commit real values.

DATABASE_URL=
GEMINI_API_KEY=
HUNTER_API_KEY=
RESEND_API_KEY=

# Every email is sent ONLY to this address (hardcoded-to-self rule).
OWNER_EMAIL=

# Optional
RESEND_FROM=onboarding@resend.dev
# Model availability differs per key; list yours with ai.models.list(). 2.5 models are closed to new users.
GEMINI_FAST_MODEL=gemini-3.8-flash
# gemini-4-carbon writes slightly richer emails but took 60-120s per draft, too slow for serverless time limits.
GEMINI_PRO_MODEL=gemini-3.8-flash
# If set, every API call must send this key (stops strangers using your quotas once deployed).
ACCESS_KEY=

# Optional: Resend webhook signing secret (whsec_...) so the Pipeline can show an open rate.
RESEND_WEBHOOK_SECRET=
